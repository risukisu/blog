---
const today = new Date();
---

<footer>
	<div class="footer-border">╚════════════════════════════════════════════════════════╝</div>
	<div class="footer-content">
		<span class="footer-copy">
			<span>&copy; {today.getFullYear()} risu</span>
			<a href="/acorn/" class="acorn-link" aria-label="acorn" title="psst">
				<svg viewBox="0 0 16 13" width="16" height="13" shape-rendering="crispEdges" aria-hidden="true"><path fill="currentColor" d="M11 0h4v1h-4zM10 1h6v1h-6zM3 2h1v1h-1zM9 2h7v1h-7zM2 3h3v1h-3zM9 3h4v1h-4zM14 3h2v1h-2zM1 4h5v1h-5zM8 4h4v1h-4zM14 4h1v1h-1zM0 5h1v1h-1zM2 5h4v1h-4zM8 5h4v1h-4zM0 6h6v1h-6zM7 6h5v1h-5zM1 7h11v1h-11zM2 8h10v1h-10zM2 9h10v1h-10zM3 10h9v1h-9zM4 11h7v1h-7zM3 12h3v1h-3zM7 12h3v1h-3z"></path></svg>
			</a>
			<span>&middot; random memories</span>
		</span>
		<div class="footer-links">
			<a href="/rss.xml">[rss]</a>
			<span>&middot;</span>
			<a href="/changelog/">[changelog]</a>
			<span>&middot;</span>
			<a href="https://github.com/risukisu" target="_blank">[github]</a>
			<span>&middot;</span>
			<a href="/friends/" class="friends-link">[friends]<span class="blink-dot"></span></a>
			<span>&middot;</span>
			<a href="/acknowledgements/">[credits]</a>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 0 1em 3em;
		max-width: 720px;
		margin: 0 auto;
	}
	.footer-border {
		color: var(--border);
		overflow: hidden;
		white-space: nowrap;
		margin-bottom: 1em;
		user-select: none;
		font-size: 0.85em;
	}
	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5em;
		color: var(--text-muted);
		font-size: 0.8em;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2em 0.5em;
	}
	.footer-copy {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
	}
	.acorn-link {
		display: inline-flex;
		align-items: center;
		padding: 6px 4px;
		margin: -6px -4px;
		color: var(--text-muted);
		opacity: 0.7;
		transition: color 0.2s, opacity 0.2s, filter 0.2s;
	}
	.acorn-link:hover,
	.acorn-link:focus-visible {
		color: var(--amber);
		opacity: 1;
		filter: drop-shadow(0 0 6px rgba(255, 183, 0, 0.45));
	}
	.acorn-link:hover svg {
		animation: acorn-hop 0.45s steps(3) 1;
	}
	@keyframes acorn-hop {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-3px); }
	}
	.footer-links a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s;
	}
	.footer-links a:hover {
		color: var(--cyan);
	}
	.friends-link {
		position: relative;
		white-space: nowrap;
	}
	.blink-dot {
		display: inline-block;
		width: 0.4em;
		height: 0.4em;
		background-color: var(--green);
		border-radius: 50%;
		margin-left: 0.3em;
		vertical-align: middle;
		animation: blink 1s infinite;
	}
	@keyframes blink {
		0%, 49% { opacity: 1; }
		50%, 100% { opacity: 0.3; }
	}
</style>
