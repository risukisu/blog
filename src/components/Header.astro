---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<a href="/" class="logo" aria-label="Home" data-logo>&gt;_</a>
		<div class="nav-links">
			<HeaderLink href="/blog/">Blog</HeaderLink>
			<HeaderLink href="/projects/">Projects</HeaderLink>
			<HeaderLink href="/me/">Me</HeaderLink>
			<a href="/campfire/" class="campfire-link" aria-label="campfire — the guestbook" title="the campfire">
				<span class="campfire-flame"></span>
			</a>
		</div>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		background: var(--bg-surface);
		border-bottom: 1px solid var(--border);
		padding: 0 1em;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 720px;
		margin: 0 auto;
		gap: 1em;
	}
	.logo {
		font-size: 1.2em;
		font-weight: 700;
		color: var(--cyan);
		text-decoration: none;
		padding: 0.75em 0;
		transition: text-shadow 0.2s;
	}
	.logo:hover {
		text-shadow: var(--glow-cyan);
	}
	.nav-links {
		display: flex;
		gap: 0.25em;
		flex: 1;
		margin-left: 1em;
		align-items: center;
	}
	.campfire-link {
		display: flex;
		align-items: center;
		padding: 0.5em 0.5em;
		opacity: 0.85;
		transition: opacity 0.2s, filter 0.2s;
	}
	.campfire-link:hover {
		opacity: 1;
		filter: brightness(1.3) drop-shadow(0 0 4px rgba(255, 183, 0, 0.5));
	}
	.campfire-flame {
		display: block;
		width: 16px;
		height: 16px;
		background: url('/campfire.png') 0 0 no-repeat;
		background-size: 64px 16px;
		image-rendering: pixelated;
		animation: nav-burn 0.8s steps(4) infinite;
	}
	@keyframes nav-burn {
		to { background-position-x: -64px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.campfire-flame { animation: none; }
	}
</style>

<script is:inline>
(function() {
	var logo = document.querySelector('[data-logo]');
	if (!logo) return;
	logo.addEventListener('dblclick', function(e) {
		e.preventDefault();
		var html = document.documentElement;
		var isOn = html.classList.toggle('crt');
		localStorage.setItem('crt', isOn ? 'on' : 'off');
	});
})();
</script>
