---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import AsciiBox from '../components/AsciiBox.astro';
import PostCard from '../components/PostCard.astro';
import LinkPreviewTooltip from '../components/LinkPreviewTooltip.astro';
import Terminal from '../components/Terminal.astro';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const terminalItems = posts.map(p => ({
	slug: p.id,
	title: p.data.title,
	description: p.data.description
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description="risu's corner of the internet — random memories of gaming, work, and everything that doesn't fit anywhere else, plus a pixel campfire." />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebSite",
					"@id": "https://risu.pl/#website",
					"url": "https://risu.pl/",
					"name": "random memories",
					"description": "risu's corner of the internet",
					"publisher": { "@id": "https://risu.pl/#person" },
					"inLanguage": "en"
				},
				{
					"@type": "Person",
					"@id": "https://risu.pl/#person",
					"name": "risu",
					"alternateName": ["risukisu", "Andrzej Białaś"],
					"url": "https://risu.pl/",
					"sameAs": [
						"https://github.com/risukisu",
						"https://www.linkedin.com/in/andrzej-bialas/",
						"https://grugbrained.substack.com"
					]
				}
			]
		})} />
	</head>
	<!--
	  ╔═══════════════════════════════════════╗
	  ║  you found the source. nice.          ║
	  ║                                       ║
	  ║       /\_/\      risu.pl              ║
	  ║      ( o.o )     random memories      ║
	  ║       > ^ <      est. 2024            ║
	  ║                                       ║
	  ║  built with mass amounts of claude    ║
	  ║  code, mass amounts of coffee,        ║
	  ║  and mass amounts of mass amounts     ║
	  ╚═══════════════════════════════════════╝
	-->
