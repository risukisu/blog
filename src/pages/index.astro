				<div class="hero-title">risu.pl</div>
				<div class="hero-subtitle">random memories & other things</div>
			</div>

			<TerminalPrompt command="whoami" />
			<p class="intro">
				A collection of my memory fragments of gaming, life, work, and everything between.
			</p>

			<TerminalPrompt command="cat recent_posts.md" />
			<AsciiBox title="recent posts">
				{posts.map((post) => (
					<PostCard
						title={post.data.title}
						date={post.data.pubDate}
						description={post.data.description}
						tags={post.data.tags}
						href={`/blog/${post.id}/`}
						variant="compact"
					/>
				))}
			</AsciiBox>

			<TerminalPrompt command="ls -la" />

			<AsciiBox title="links">
				<div class="link-list">
					<a href="/blog/" class="link-item">
						<span class="link-glyph">[blog]</span>
						<span class="link-desc">random memories — gaming, life, work, and everything between</span>
					</a>
					<a href="https://github.com/risukisu" target="_blank" class="link-item">
						<span class="link-glyph">[github]</span>
						<span class="link-desc">code & projects</span>
					</a>
				</div>
			</AsciiBox>

			<Terminal context={{ type: 'blog', items: terminalItems }} />
		</main>
		<Footer />
		<LinkPreviewTooltip />
	</body>
</html>

<style>
	.ascii-hero {
		text-align: center;
		margin-bottom: 1.5em;
	}
	.mascot {
		display: inline-block;
		font-size: 0.5em;
		line-height: 1.1;
		text-align: left;
		background: none !important;
		border: none !important;
		padding: 0 !important;
		margin: 0;
		color: var(--amber);
	}
	@media (max-width: 720px) {
		.mascot {
			font-size: 0.32em;
		}
	}
	.hero-title {
		color: var(--cyan);
		font-size: 1.4em;
		font-weight: 700;
		margin-top: 0.5em;
		text-shadow: var(--glow-cyan);
		letter-spacing: 0.1em;
	}
	.hero-subtitle {
		color: var(--text-muted);
		font-size: 0.85em;
		margin-top: 0.25em;
	}
	.intro {
		color: var(--text-bright);
		font-size: 1em;
		margin: 0.25em 0 2em;
	}
	.link-list {
		display: flex;
		flex-direction: column;
		gap: 0.75em;
	}
	.link-item {
		display: flex;
		gap: 0.75em;
		align-items: baseline;
		text-decoration: none;
		padding: 0.4em 0;
		transition: all 0.2s;
	}
	.link-item:hover {
		text-shadow: var(--glow-cyan);
	}
	.link-item:hover .link-desc {
		color: var(--text-bright);
	}
	.link-glyph {
		color: var(--cyan);
		font-weight: 700;
		white-space: nowrap;
	}
	.link-desc {
		color: var(--text-muted);
		font-size: 0.85em;
		transition: color 0.2s;
	}
</style>
